{
  "manifest_version": 3,
  "name": "YouTube Vertical Monitor Layout",
  "short_name": "YT Vertical Layout",
  "version": "0.1.0",
  "description": "Rearranges YouTube's native interface for portrait (vertical) monitors: edge-to-edge video, two-column comments and recommendations, chat under the player.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "exclude_matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/live_chat_replay*"
      ],
      "css": [
        "src/styles/base.css",
        "src/styles/watch.css",
        "src/styles/live.css",
        "src/styles/browse.css"
      ],
      "js": [
        "src/content/portrait.js",
        "src/content/pages.js",
        "src/content/navigation.js",
        "src/content/index.js"
      ],
      "run_at": "document_start"
    }
  ]
}
