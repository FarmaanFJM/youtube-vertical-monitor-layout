{
  "name": "youtube-vertical-monitor-layout",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that rearranges YouTube's native interface for portrait monitors.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "validate": "node scripts/validate.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test --project=fixtures",
    "test:live": "playwright test --project=live",
    "test": "npm run lint && npm run validate && npm run test:unit && npm run test:e2e",
    "package": "node scripts/package.mjs",
    "screenshots:live": "node scripts/capture-screenshots.mjs live",
    "screenshots:fixture": "node scripts/capture-screenshots.mjs fixture",
    "screenshots:install": "node scripts/capture-screenshots.mjs install"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "~1.63.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  }
}
